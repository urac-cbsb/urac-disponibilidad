rules_version = '2';

// Reglas de seguridad · URAC Disponibilidad
// Se pegan en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{db}/documents {

    // Solo cuentas con correo confirmado.
    function signed() { return request.auth != null && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function perfilPath() { return /databases/$(db)/documents/nomina/$(myEmail()); }
    function configPath() { return /databases/$(db)/documents/config/inicial; }
    function member() { return signed() && exists(perfilPath()) && get(perfilPath()).data.activo == true; }
    function rol() { return get(perfilPath()).data.rol; }
    function lider() { return member() && rol() in ['lider', 'admin']; }
    // Gerencia según el cargo: jefes, Líder Alfa, Líder Bravo y LUMED (además del Líder y el Administrador).
    function gerencia() { return lider() || (member() && get(perfilPath()).data.cargo in ['Jefe de Operaciones', 'Jefe de Planificación', 'Jefe de Logística', 'Jefe de Administración y Finanzas', 'Líder Alfa', 'Líder Bravo', 'LUMED']); }

    function miCordada() { return get(perfilPath()).data.get('cordada', null); }
    function miNombre() { return get(perfilPath()).data.nombre; }
    // Clave de cada integrante en el resumen de Gerencia: su correo sin símbolos.
    function miClave() { return myEmail().replace('[^a-z0-9]', '_'); }
    // Pueden sacar el informe: Líder, Administrador, Jefe de Operaciones y Jefe de Planificación.
    function informe() { return lider() || (member() && get(perfilPath()).data.cargo in ['Jefe de Operaciones', 'Jefe de Planificación']); }
    function nominaValida(d) {
      return d.keys().hasOnly(['nombre', 'cargo', 'rol', 'cordada', 'activo'])
        && d.get('cordada', null) in [null, 'lider_cordada', 'navegante', 'tecnico', 'sanitario', 'comunicaciones', 'apoyo']
        && d.nombre is string && d.nombre.size() > 1 && d.nombre.size() <= 100
        && d.cargo is string && d.cargo.size() <= 100
        && d.rol in ['rescatista', 'gerencia', 'lider', 'admin']
        && d.activo is bool;
    }

    // Marca de configuración inicial: permite registrar al primer Administrador una sola vez.
    match /config/inicial {
      allow read: if signed();
      allow create: if signed() && !exists(configPath())
        && request.resource.data.keys().hasOnly(['por', 'en'])
        && request.resource.data.por == myEmail()
        && existsAfter(perfilPath()) && getAfter(perfilPath()).data.rol == 'admin';
      allow update, delete: if false;
    }

    // Nómina: cada integrante ve solo su ficha; el Líder y el Administrador ven y editan todas.
    match /nomina/{email} {
      allow read: if (signed() && email == myEmail()) || informe();
      allow create: if nominaValida(request.resource.data) && email == email.lower() && (
        lider() ||
        (signed() && email == myEmail() && !exists(configPath()) && existsAfter(configPath())
          && request.resource.data.rol == 'admin' && request.resource.data.activo == true));
      allow update: if lider() && nominaValida(request.resource.data);
      allow delete: if false;
    }

    // Foto de cada integrante: la sube el Líder o el Administrador; la ven el propio integrante y el Líder.
    match /fotos/{email} {
      allow read: if (signed() && email == myEmail()) || lider();
      allow create, update: if lider() && request.resource.data.keys().hasOnly(['img'])
        && request.resource.data.img is string && request.resource.data.img.size() < 200000
        && request.resource.data.img.matches('^data:image/jpeg;base64,.*');
      allow delete: if lider();
    }

    // Llamados (fases de Monitoreo, Alerta y Movilización).
    match /llamados/{id} {
      function llamadoValido(d) {
        return d.fase in ['monitoreo', 'alerta', 'movilizacion', 'operaciones', 'desmovilizacion']
          && d.nivel in ['local', 'regional', 'sno']
          && d.abierto is bool
          && d.descripcion is string && d.descripcion.size() <= 500
          && (!('lugar' in d) || (d.lugar.lat is number && d.lugar.lon is number && d.lugar.nombre is string));
      }
      function abierto() { return get(/databases/$(db)/documents/llamados/$(id)).data.abierto == true; }

      allow read: if member();
      allow create: if lider() && llamadoValido(request.resource.data) && request.resource.data.abierto == true;
      allow update: if lider() && llamadoValido(request.resource.data);
      allow delete: if lider() && resource.data.abierto == false;

      // Bitácora de movimientos (base del informe): no se modifica; solo se borra al eliminar un llamado cerrado.
      match /eventos/{ev} {
        allow read: if informe();
        allow create: if member()
          && request.resource.data.keys().hasOnly(['tipo', 'fase', 'detalle', 'por', 'nombre', 'en'])
          && request.resource.data.por == myEmail()
          && request.resource.data.nombre == miNombre()
          && request.resource.data.en == request.time
          && request.resource.data.detalle is string && request.resource.data.detalle.size() <= 500
          && ((request.resource.data.tipo == 'respuesta' && abierto())
              || (lider() && request.resource.data.tipo in ['apertura', 'fase', 'mapa', 'cierre', 'manual']));
        allow update: if false;
        allow delete: if lider() && !abierto();
      }

      // Imagen georreferencial del lugar: la carga el Líder o el Administrador; la ven todos.
      match /adjuntos/{a} {
        allow read: if member();
        allow create, update: if lider()
          && request.resource.data.keys().hasOnly(['img', 'por', 'nombre', 'en'])
          && request.resource.data.img is string && request.resource.data.img.size() < 900000
          && request.resource.data.img.matches('^data:image/jpeg;base64,.*')
          && request.resource.data.en == request.time;
        allow delete: if lider();
      }

      // Respuesta de cada integrante: solo él la escribe; solo él y el Líder la leen.
      match /respuestas/{email} {
        allow read: if informe() || (member() && email == myEmail());
        // La escribe el propio integrante o, como ingreso manual, el Líder o el Administrador.
        allow create, update: if member() && abierto()
          && (email == myEmail() || (lider() && exists(/databases/$(db)/documents/nomina/$(email))))
          && request.resource.data.keys().hasOnly(['estado', 'hasta', 'eta', 'en'])
          && request.resource.data.estado in ['si', 'no']
          && (request.resource.data.hasta == null || request.resource.data.hasta is timestamp)
          && (request.resource.data.eta == null || request.resource.data.eta is timestamp)
          && request.resource.data.en == request.time;
        allow delete: if lider() && !abierto();
      }

      // Resumen para Gerencia: estado, perfil de cordada y nombre de cada integrante.
      match /resumen/{doc} {
        allow read: if gerencia();
        allow create: if lider() && request.resource.data.keys().hasOnly(['r']);
        allow update: if member() && abierto()
          && request.resource.data.keys().hasOnly(['r'])
          && request.resource.data.r.diff(resource.data.r).affectedKeys().size() <= 1
          && (lider() || (
               request.resource.data.r.diff(resource.data.r).affectedKeys().hasOnly([miClave()])
               && request.resource.data.r[miClave()].keys().hasOnly(['e', 'h', 't', 'c', 'n'])
               && request.resource.data.r[miClave()].e in ['si', 'no']
               && request.resource.data.r[miClave()].get('c', null) == miCordada()
               && request.resource.data.r[miClave()].get('n', '') == miNombre()));
        allow delete: if lider() && !abierto();
      }
    }
  }
}
